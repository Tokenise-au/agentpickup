# Copy to .env. Everything is optional: with nothing set the demo runs on test payments
# and shows emails on the page instead of sending them.
PORT=8402
BASE_URL=http://localhost:8402

# Card payments (use test keys: sk_test_...). Holds the card, captures on scan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe profile id (profile_*), advertised to UCP platforms with the com.stripe.payments handler.
STRIPE_PROFILE_ID=

# Agent payments over x402: the wallet that receives USDC, and the network.
# eip155:84532 = Base Sepolia (test USDC), eip155:8453 = Base mainnet.
X402_PAY_TO=
X402_NETWORK=eip155:84532

# MPP (Machine Payments Protocol): agents pay by card or Link through Stripe Shared Payment Tokens.
# Needs STRIPE_SECRET_KEY plus Stripe's MPP access (network id from the dashboard) and a 32+ char secret.
MPP_NETWORK_ID=
MPP_CHALLENGE_SECRET=

# ACP: the Bearer key you issue to an agent platform. The demo falls back to a public "demo-acp-key".
ACP_API_KEY=

# Real email delivery through Resend. MAIL_FROM must be a sender Resend has verified.
RESEND_API_KEY=
MAIL_FROM=Demo Café <orders@example.com>

# Staff scanner key. Leave empty only for the public demo.
STAFF_KEY=
# Lets you read signups at /admin/waitlist?key=...
ADMIN_KEY=
# Pass-signing key (PKCS#8 PEM, \n-escaped). Generated into data/ if unset.
SIGNING_KEY_PEM=
# ES256 (P-256) key for AP2 merchant signatures on UCP checkouts. Generated into data/ if unset.
AP2_SIGNING_KEY_PEM=
TIME_ZONE=Australia/Brisbane

# The demo's own agent wallet (Base Sepolia TESTNET keys only). With DEMO_CAFE_KEY set, the café's address
# is the x402 payTo and X402_PAY_TO is ignored. Fund the agent with test USDC from faucet.circle.com.
DEMO_AGENT_KEY=
DEMO_CAFE_KEY=
# Most payments the demo agent makes per UTC day (default 60).
DEMO_AGENT_DAILY_LIMIT=
