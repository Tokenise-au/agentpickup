{
  "name": "@agentpickup/server",
  "version": "0.3.0",
  "description": "The pickup layer for agent payments: x402, MPP, UCP (+AP2), ACP and card checkout in; a signed QR pickup pass out; scan to hand over and settle.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "static",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "acp",
    "agent-payments",
    "agentic-commerce",
    "ap2",
    "click-and-collect",
    "mpp",
    "pickup",
    "pos",
    "qr",
    "square",
    "ucp",
    "x402"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dav3trad3r/agentpickup.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/dav3trad3r/agentpickup#readme",
  "bugs": {
    "url": "https://github.com/dav3trad3r/agentpickup/issues"
  },
  "author": "Dave Hallett",
  "license": "FSL-1.1-ALv2",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentpickup/core": "^0.2.0",
    "@hono/node-server": "^2.1.6",
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "@x402/hono": "2.29.0",
    "hono": "^4.13.16",
    "jsqr": "^1.4.0",
    "mppx": "^0.17.0",
    "qrcode": "^1.5.4",
    "stripe": "^23.1.0",
    "viem": "^2.57.14"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10"
  }
}
